# ============================================================
# MOTOKASS — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# ---- SUPABASE ------------------------------------------------
# Panel: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tablas necesarias (SQL en src/pages/api/agendar-cita.ts):
#   subscribers(id, email, notified, created_at)
#   citas(id, nombre, email, telefono, fecha, hora, vehiculo, motivo, resumen, estado, created_at)

# ---- RESEND (envío de emails) --------------------------------
# Panel: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend (dominio motokass.com ya disponible)
RESEND_FROM=noreply@motokass.com

# Email real donde el taller recibe notificaciones de citas y contacto
# (puede ser Gmail u otro buzón real — Resend solo envía, no crea buzones)
TALLER_EMAIL=tu_email@ejemplo.com

# ---- PANEL ADMIN ---------------------------------------------
# Contraseña para acceder a /admin — cámbiala por algo seguro
ADMIN_PASSWORD=cambia_esta_clave_ahora

# ---- WHATSAPP ------------------------------------------------
# Número en formato internacional sin + ni espacios
# Debe ser un número de móvil (WhatsApp no funciona con fijos)
# Ejemplo: 34612345678 (España +34 612 345 678)
WHATSAPP_NUMBER=34653973209

# ---- TIENDA ONLINE: STRIPE (pagos) ---------------------------
# Panel: https://dashboard.stripe.com/test/apikeys  (usar claves de TEST hasta producción)
# Solo servidor: NUNCA con prefijo PUBLIC_. Stripe Checkout es alojado: no hace falta clave publicable.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Secreto de firma del endpoint /api/webhooks/stripe (Dashboard → Webhooks, o 'stripe listen' en local)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# URL pública para volver de Stripe (success/cancel). Vacío = origen de la petición (útil en previews).
SITE_URL=https://motokass.com

# Buzón que recibe los avisos de pedido nuevo (si vacío: TALLER_EMAIL)
STORE_ORDERS_EMAIL=

# Secreto de los cron de Vercel (/api/cron/*). Vercel lo envía como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=genera_una_cadena_aleatoria_larga
