{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-launch-emails/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/subscribe/?$",
			"dest": "_render"
		},
		{
			"src": "^/CitaPrevia/?$",
			"dest": "_render"
		},
		{
			"src": "^/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/Ofertas/?$",
			"dest": "_render"
		},
		{
			"src": "^/taller/?$",
			"dest": "_render"
		},
		{
			"src": "^/tienda/?$",
			"dest": "_render"
		},
		{
			"src": "^/under-construction/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}