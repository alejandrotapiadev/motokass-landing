---
import "../styles/global.css";
import ScrollTop from "../components/ScrollTop.astro";
import WhatsApp from "../components/WhatsApp.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { Analytics } from "@vercel/analytics/react";
import { SpeedInsights } from "@vercel/speed-insights/react";

const {
  title = "MOTOKASS — Concesionario y Taller de Motos en Ávila",
  description = "Distribuidor oficial Rieju y Sherco en Ávila. Catálogo de motos, taller mecánico, cita previa y asesoramiento personalizado.",
  ogImage = "https://motokass.com/fachada.png",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!--script JSON-LD de la app -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": [
          "MotorcycleDealer",
          "LocalBusiness"
        ],
        "name": "Motokass",
        "alternateName": [
          "Moto Kass",
          "MotoKass",
          "Kass Moto",
          "Kass Motos",
          "Moto Kass Online",
          "Motokas",
          "Motos Kass",
          "MotosKass",
          "KassMoto",
          "KassMotos",
          "MotoKassOnline",
          "KassBikes",
          "MotosKassShop",
          "MotoKassStore",
          "MotokassMX",
          "MotosKass.com",
          "KassMotoStore",
          "MotokasMotos",
          "MotoKassWorld",
          "MotoKassShopOnline",
          "KassMotosOnline",
          "MotosKassOnlineShop",
          "MotoKassTienda",
          "KassMotosShop",
          "MotokassTiendaOnline",
          "MotosKassWorld",
          "KassMotoWorld"
        ],
        "url": "https://motokass.com",
        "logo": "https://motokass.com/favicon.svg",
        "image": "https://motokass.com/fachada.png",
        "description": "Motokass es una tienda y taller mecánico de motos especializada en venta, mantenimiento y reparación.",
        "telephone": "+34920254044",
        "priceRange": "€€",
        "areaServed": "ES",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "C. de la Virgen María, 20",
          "addressLocality": "Ávila",
          "addressRegion": "Ávila",
          "postalCode": "05003",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 40.6525721,
          "longitude": -4.6851359
        },
        "hasMap": "https://www.google.com/maps/place/Moto+Kass/@40.6525761,-4.6877108,17z/data=!3m1!4b1!4m6!3m5!1s0xd40f313ac754745:0xcfeb50ee9c5664c1!8m2!3d40.6525721!4d-4.6851359!16s%2Fg%2F11kl1070yk?entry=ttu&g_ep=EgoyMDI2MDIxOC4wIKXMDSoASAFQAw%3D%3D",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday"
            ],
            "opens": "10:00",
            "closes": "13:45"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday"
            ],
            "opens": "15:30",
            "closes": "19:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Friday",
            "opens": "10:00",
            "closes": "14:00"
          }
        ],
        "sameAs": [
          "https://instagram.com/moto_kass/",
          "https://facebook.com/MOTO_KASS"
        ]
      }
    </script>
    <!-- Meta tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="LGtP0_svT6qHUjXgeFwugHSspMv_9X8iOq1i5e_LKVY">
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MOTOKASS" />
    <meta property="og:locale" content="es_ES" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="page-container">
    <Header></Header>
    <main class="content">
      <slot />
    </main>
    <ScrollTop />
    <WhatsApp />
    <Footer></Footer>
    <Analytics client:only="react" />
    <SpeedInsights client:only="react" />
  </body>
</html>

<style>
/* Contenedor flex para todo el layout */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh; /* ocupa toda la altura de la pantalla */
  /*background: #395A99;
  background: linear-gradient(
    140deg,
    rgba(57, 90, 153, 0.81) 0%,
    rgba(57, 90, 153, 1) 26%,
    rgba(102, 153, 242, 1) 100%
  );*/
  background-color: var(--color-gray-medium);
}

/* Main crece para empujar el footer abajo */
.content {
  flex: 1; /* permite que main crezca para empujar footer al final */
  min-height: 100vh;
}

/* Footer */
footer {
  background: #f1f5f9;
  padding: 1.5rem;
  text-align: center;
}

</style>
