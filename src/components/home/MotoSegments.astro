---
import { MOTO_SEGMENTS, getSegmentCover, getMotorcyclesBySegment } from "../../lib/catalog/motorcycles";

const segments = MOTO_SEGMENTS.map((s) => ({
  ...s,
  cover: getSegmentCover(s.slug),
  count: getMotorcyclesBySegment(s.slug).length,
}));
---

<section class="section section--dark" id="encuentra-tu-moto" aria-labelledby="segments-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Encuentra tu moto</span>
        <h2 id="segments-title">¿Qué tipo de moto buscas?</h2>
        <p>Elige tu estilo y te mostramos los modelos disponibles.</p>
      </div>
    </div>

    <ul class="seg-grid">
      {segments.map((s) => (
        <li>
          <a href={`/catalogo?segmento=${s.slug}`} class="seg">
            {s.cover && <img src={s.cover.images[0]} alt="" loading="lazy" decoding="async" width="640" height="400" />}
            <span class="seg__label">
              <strong>{s.name}</strong>
              <span><span class="seg__desc">{s.description} · </span>{s.count} modelos</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.seg-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
.seg {
  position: relative;
  display: block;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--graphite);
  isolation: isolate;
}
.seg img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s var(--ease), opacity .3s;
  opacity: .85;
}
.seg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14,15,18,0) 35%, rgba(14,15,18,.9) 100%);
}
.seg:hover img { transform: scale(1.05); opacity: 1; }
.seg__label {
  position: absolute;
  z-index: 1;
  left: 1.25rem;
  right: 1.25rem;
  bottom: 1rem;
  display: grid;
  gap: .2rem;
}
.seg__label strong {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  line-height: 1;
}
.seg__label strong::after {
  content: "";
  display: block;
  width: 32px;
  height: 3px;
  background: var(--accent);
  margin-top: .4rem;
  transition: width .3s var(--ease);
}
.seg:hover .seg__label strong::after { width: 64px; }
.seg__label span { font-size: .85rem; color: var(--text-inv-2); }

@media (max-width: 900px) { .seg-grid { grid-template-columns: repeat(2, 1fr); gap: .75rem; } }
@media (max-width: 480px) {
  .seg { aspect-ratio: 4 / 3; }
  .seg__label { left: .85rem; right: .85rem; bottom: .75rem; }
  .seg__label span { font-size: .75rem; }
  .seg__desc { display: none; }
  .seg::after { background: linear-gradient(180deg, rgba(14,15,18,0) 25%, rgba(14,15,18,.92) 100%); }
}
</style>
