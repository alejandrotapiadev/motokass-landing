---
/**
 * Reseñas. Solo muestra testimonios reales de src/data/reviews.ts, en un
 * carrusel (scroll-snap nativo, sin dependencias) con ilusión de bucle
 * infinito: swipe en táctil, flechas, paginación y teclado. Escritorio 3
 * tarjetas, tablet 2, móvil 1; la pista llega al borde de la ventana y
 * asoman la anterior y la siguiente.
 * Mientras esté vacío, invita a leer las reseñas en Google.
 */
import Icon from "../ui/Icon.astro";
import { REVIEWS } from "../../data/reviews";
import { SITE } from "../../lib/site";

// Avatar de iniciales (no hay fotos en los datos): "Ignacio C." → "IC".
const initials = (name: string) =>
  name
    .replace(/\./g, "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

const STAR = "M12 2.6l2.83 5.73 6.33.92-4.58 4.46 1.08 6.3L12 17.04l-5.66 2.97 1.08-6.3-4.58-4.46 6.33-.92z";
---

<section class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews__head">
      <span class="eyebrow">Opiniones</span>
      <h2 id="reviews-title" class="display">Más de 500 clientes han confiado en MOTOKASS.</h2>
    </div>

    {REVIEWS.length > 0 && (
      <div class="rv" data-rv role="region" aria-roledescription="carrusel" aria-label="Opiniones de clientes">
        <ul class="rv__track" data-rv-track tabindex="0" aria-label="Opiniones de clientes. Usa las flechas izquierda y derecha para desplazarte.">
          {REVIEWS.map((r, i) => (
            <li class="rv__slide" style={`--i:${i}`} aria-roledescription="opinión" aria-label={`${i + 1} de ${REVIEWS.length}`}>
              <article class="rcard">
                <div class="rcard__top">
                  <span class="rcard__stars" role="img" aria-label={`${r.rating} de 5 estrellas`}>
                    {Array.from({ length: 5 }, (_, s) => (
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class={s < r.rating ? "on" : "off"}><path d={STAR} /></svg>
                    ))}
                  </span>
                  {r.source === "google" && (
                    <svg class="rcard__g" width="18" height="18" viewBox="0 0 24 24" role="img" aria-label="Reseña de Google"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                  )}
                </div>

                <blockquote class="rcard__text"><p>“{r.text}”</p></blockquote>

                <footer class="rcard__author">
                  <span class="rcard__avatar" aria-hidden="true">{initials(r.author)}</span>
                  <span class="rcard__meta">
                    <strong>{r.author}</strong>
                    <span>
                      {r.date}
                      {r.source === "google" && (r.url
                        ? <> · <a href={r.url} target="_blank" rel="noopener noreferrer">Google</a></>
                        : <> · Google</>)}
                    </span>
                  </span>
                </footer>
              </article>
            </li>
          ))}
        </ul>

        <div class="rv__controls" data-rv-nav hidden>
          <button type="button" class="rv__arrow" data-rv-prev aria-label="Opiniones anteriores">
            <Icon name="chevron-left" size={20} />
          </button>
          <div class="rv__dots" data-rv-dots role="group" aria-label="Elegir opiniones"></div>
          <button type="button" class="rv__arrow" data-rv-next aria-label="Opiniones siguientes">
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </div>
    )}

    <div class="reviews__cta">
      <a href={SITE.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Leer opiniones en Google
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
/* overflow: la pista sangra hasta el borde de la ventana; se recorta aquí
   para que nunca haya scroll horizontal de página. */
.reviews { text-align: center; overflow: hidden; }
.reviews__head { max-width: 820px; margin: 0 auto 2.5rem; }
.reviews__head h2 { font-size: clamp(2.2rem, 4.5vw, 3.6rem); margin: 0; }

/* ── Carrusel ── */
.rv {
  /* Hueco entre el contenido del .container y el borde de la ventana. */
  --bleed: calc(max(0px, (100vw - var(--container-width)) / 2) + var(--gutter));
  --gap: 1.5rem;
  --per-view: 3;
  margin: 0 0 2.75rem;
  text-align: left;
}
.rv__track {
  list-style: none;
  margin: 0 calc(var(--bleed) * -1);
  padding: .5rem var(--bleed) 1.25rem; /* aire para la sombra de las tarjetas */
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  gap: var(--gap);
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: var(--bleed);
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.rv__track::-webkit-scrollbar { display: none; }
.rv__track:focus { outline: none; }
.rv__slide { scroll-snap-align: start; display: flex; min-width: 0; }

/* ── Tarjeta ── */
.rcard {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  width: 100%;
  padding: clamp(1.5rem, 2.4vw, 2rem);
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: 0 1px 2px rgba(14, 15, 18, .04);
  overflow: hidden;
  transition: border-color .3s var(--ease), box-shadow .3s var(--ease), transform .3s var(--ease), opacity .45s var(--ease);
}
/* Línea de marca superior, aparece al pasar por encima. */
.rcard::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 3px;
  background: var(--brand);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .45s var(--ease);
}
@media (hover: hover) {
  .rcard:hover { border-color: #CFCFCB; box-shadow: var(--shadow-1); transform: translateY(-2px); }
  .rcard:hover::before { transform: scaleX(1); }
}

.rcard__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.rcard__stars { display: inline-flex; gap: 2px; line-height: 0; }
.rcard__stars .on { fill: #F4B400; }
.rcard__stars .off { fill: var(--line); }
.rcard__g { flex: none; opacity: .9; }

.rcard__text { margin: 0; flex: 1; }
.rcard__text p {
  margin: 0;
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--text);
  overflow-wrap: anywhere;
}

.rcard__author {
  display: flex;
  align-items: center;
  gap: .85rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--line);
}
.rcard__avatar {
  flex: none;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.05rem;
  letter-spacing: .04em;
}
.rcard__meta { display: grid; gap: .15rem; min-width: 0; }
.rcard__meta strong { font-size: .95rem; font-weight: 600; color: var(--text); }
.rcard__meta span { font-size: .82rem; color: var(--text-2); }
.rcard__meta a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

/* Tarjetas que asoman (no visibles del todo): atenuadas. Solo con JS activo. */
.rv.is-ready .rv__slide:not(.is-visible) .rcard { opacity: .45; }
/* Foco de teclado en la pista: se marca el grupo de tarjetas visibles. */
.rv__track:focus-visible .rv__slide.is-visible .rcard { outline: 2px solid var(--brand-2); outline-offset: 3px; }

/* ── Controles ── */
.rv__controls { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-top: 1rem; }
.rv__controls[hidden] { display: none; }
.rv__arrow {
  flex: none;
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  cursor: pointer;
  transition: background-color .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease), opacity .25s;
}
.rv__arrow:hover:not(:disabled) { background: var(--ink); border-color: var(--ink); color: #fff; }
.rv__arrow:focus-visible { outline: 2px solid var(--brand-2); outline-offset: 3px; }
.rv__arrow:disabled { opacity: .35; cursor: default; }

.rv__dots { display: flex; align-items: center; gap: .25rem; }
.rv__dot {
  width: 24px;
  height: 24px;
  padding: 0;
  border: 0;
  background: none;
  display: grid;
  place-items: center;
  cursor: pointer;
}
.rv__dot::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #C9CBCF;
  transition: width .35s var(--ease), background-color .35s var(--ease);
}
.rv__dot:hover::before { background: var(--text-2); }
.rv__dot[aria-current="true"]::before { width: 22px; background: var(--brand); }
.rv__dot:focus-visible { outline: 2px solid var(--brand-2); outline-offset: 0; border-radius: 4px; }

/* ── Entrada: aparición escalonada y suave al llegar a la sección ── */
.rv.is-pending .rv__slide { opacity: 0; transform: translateY(14px); }
.rv.is-revealed .rv__slide {
  transition: opacity .7s var(--ease), transform .7s var(--ease);
  transition-delay: calc(min(var(--i), 3) * 90ms);
}

.reviews__cta { display: flex; justify-content: center; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .rv { --per-view: 2; --gap: 1.25rem; }
}
@media (max-width: 640px) {
  /* 1 tarjeta y asoma la siguiente para invitar al swipe. */
  .rv { --gap: .875rem; }
  .rv__track { grid-auto-columns: 86%; }
  .rcard__text p { font-size: 1rem; }
  .rv__controls { gap: .75rem; }
}
@media (max-width: 360px) {
  .rv__track { grid-auto-columns: 92%; }
  .rcard { padding: 1.25rem; }
  /* El CTA (320 px sin partir) no cabe en el ancho útil de un móvil de 320. */
  .reviews__cta .btn { width: 100%; white-space: normal; text-align: center; padding-inline: 1rem; }
}

@media (prefers-reduced-motion: reduce) {
  .rv__track { scroll-behavior: auto; }
  .rcard, .rcard::before, .rv__dot::before { transition: none; }
  .rcard:hover { transform: none; }
}
</style>

<script>
  // Carrusel de reseñas: flechas, paginación, teclado y atenuado de las
  // tarjetas que asoman. El desplazamiento y el swipe son scroll nativo.
  //
  // Ilusión de carrusel infinito: se clonan las tarjetas a ambos lados
  // (COPIES juegos por lado, ocultos a lectores de pantalla e inertes) y,
  // cuando el desplazamiento se detiene, la pista se recoloca en el juego
  // central desplazándose exactamente n tarjetas. Como el contenido es
  // idéntico, el salto no se ve. Con pocas reseñas (caben todas) no hay bucle.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const MAX_PER_VIEW = 3; // escritorio
  const COPIES = 2; // margen para flechazos rápidos o swipes largos

  document.querySelectorAll<HTMLElement>("[data-rv]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-rv-track]")!;
    const nav = root.querySelector<HTMLElement>("[data-rv-nav]")!;
    const dotsBox = root.querySelector<HTMLElement>("[data-rv-dots]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-rv-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-rv-next]")!;

    const real = [...track.querySelectorAll<HTMLElement>(".rv__slide")];
    const n = real.length;
    const loop = n > MAX_PER_VIEW;

    if (loop) {
      const copySet = () =>
        real.map((s) => {
          const c = s.cloneNode(true) as HTMLElement;
          c.classList.add("is-clone");
          c.setAttribute("aria-hidden", "true");
          c.removeAttribute("aria-label");
          c.removeAttribute("aria-roledescription");
          c.inert = true;
          return c;
        });
      for (let k = 0; k < COPIES; k++) {
        track.prepend(...copySet());
        track.append(...copySet());
      }
    }

    const slides = [...track.querySelectorAll<HTMLElement>(".rv__slide")];
    const first = loop ? COPIES * n : 0; // índice de la primera tarjeta real

    let step = 1; // ancho de tarjeta + hueco (fraccionario)
    let perView = 1;
    let pages = loop ? n : 1; // posiciones de los puntos
    let target: number | null = null; // destino de la animación en curso
    let current = 0; // reseña (0..n-1) o página activa
    // Reseña de referencia: solo cambia con navegación del usuario, no con los
    // reajustes de scroll que hace el navegador al cambiar el tamaño.
    let anchor = 0;
    let resizedAt = -Infinity;
    let dots: HTMLButtonElement[] = [];

    const maxScroll = () => track.scrollWidth - track.clientWidth;
    const indexAt = (x: number) => Math.round(x / step);
    const realOf = (i: number) => (((i - first) % n) + n) % n;
    const smooth = (): ScrollBehavior => (reduceMotion.matches ? "instant" : "smooth");

    // Recoloca la pista en el juego central sin cambio visible.
    const normalize = () => {
      if (!loop) return;
      const x = track.scrollLeft;
      const i = indexAt(x);
      const shift = first + realOf(i) - i; // múltiplo de n
      if (shift !== 0) {
        track.scrollTo({ left: x + shift * step, behavior: "instant" });
        if (target !== null) target += shift;
      }
    };

    const scrollToIndex = (i: number) => {
      target = i;
      anchor = loop ? realOf(i) : i;
      track.scrollTo({ left: Math.min(i * step, maxScroll()), behavior: smooth() });
    };

    const move = (delta: number) => {
      normalize();
      const from = target ?? indexAt(track.scrollLeft);
      scrollToIndex(loop ? from + delta : Math.max(0, Math.min(from + delta, pages - 1)));
    };

    // Ir a la reseña r (0..n-1) por el camino más corto.
    const goToReal = (r: number) => {
      if (!loop) return scrollToIndex(Math.max(0, Math.min(r, pages - 1)));
      normalize();
      const from = target ?? indexAt(track.scrollLeft);
      const base = from - realOf(from) + r;
      const dest = [base - n, base, base + n].reduce((a, b) => (Math.abs(b - from) < Math.abs(a - from) ? b : a));
      scrollToIndex(dest);
    };

    const label = (i: number) => {
      if (loop) return `Ir a la opinión ${i + 1} de ${n}`;
      const to = Math.min(i + perView, n);
      return i + 1 === to ? `Opinión ${i + 1} de ${n}` : `Opiniones ${i + 1} a ${to} de ${n}`;
    };

    const buildDots = () => {
      dotsBox.replaceChildren();
      // Los estilos con ámbito de Astro necesitan el atributo del componente.
      const scope = [...root.attributes].find((a) => a.name.startsWith("data-astro-cid-"));
      dots = Array.from({ length: pages }, (_, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "rv__dot";
        b.setAttribute("aria-label", label(i));
        if (scope) b.setAttribute(scope.name, "");
        b.addEventListener("click", () => goToReal(i));
        dotsBox.append(b);
        return b;
      });
    };

    const update = () => {
      const x = track.scrollLeft;
      const max = maxScroll();
      current = loop ? realOf(indexAt(x)) : x >= max - 2 ? pages - 1 : indexAt(x);
      dots.forEach((d, i) => d.setAttribute("aria-current", String(i === current)));
      if (!loop) {
        prev.disabled = x <= 2;
        next.disabled = x >= max - 2;
      }

      // Tarjetas completamente dentro de la zona de contenido.
      const cs = getComputedStyle(track);
      const box = track.getBoundingClientRect();
      const left = box.left + parseFloat(cs.paddingLeft) - 2;
      const right = box.right - parseFloat(cs.paddingRight) + 2;
      slides.forEach((s) => {
        const r = s.getBoundingClientRect();
        s.classList.toggle("is-visible", r.left >= left && r.right <= right);
      });
    };

    // Mide y vuelve a colocar la pista en la misma reseña (carga y resize).
    const measure = () => {
      const keep = anchor;
      const cs = getComputedStyle(track);
      const gap = parseFloat(cs.columnGap) || 0;
      const inner = track.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      step = slides.length > 1
        ? slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left
        : slides[0].getBoundingClientRect().width + gap;
      perView = Math.max(1, Math.floor((inner + gap + 1) / step));
      const newPages = loop ? n : Math.max(1, n - perView + 1);
      if (newPages !== pages || dots.length === 0) {
        pages = newPages;
        buildDots();
      }
      nav.hidden = !loop && maxScroll() <= 1;
      target = null;
      track.scrollTo({ left: Math.min((first + Math.min(keep, pages - 1)) * step, maxScroll()), behavior: "instant" });
      update();
    };

    // Fin del desplazamiento: scrollend donde existe; si no, una pausa breve.
    const settle = () => {
      target = null;
      // Tras redimensionar, el reajuste lo hace measure() con medidas nuevas.
      if (performance.now() - resizedAt < 400) return;
      normalize();
      update();
      anchor = current;
    };
    let frame = 0;
    let idle = 0;
    const hasScrollEnd = "onscrollend" in window;
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
      if (!hasScrollEnd) {
        clearTimeout(idle);
        idle = window.setTimeout(settle, 150);
      }
    }, { passive: true });
    if (hasScrollEnd) track.addEventListener("scrollend", settle);

    prev.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("keydown", (e) => {
      const actions: Record<string, () => void> = {
        ArrowLeft: () => move(-1),
        ArrowRight: () => move(1),
        Home: () => goToReal(0),
        End: () => goToReal(loop ? n - 1 : pages - 1),
      };
      if (e.key in actions) {
        e.preventDefault();
        actions[e.key]();
      }
    });

    let lastInnerWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastInnerWidth) return; // p. ej. barra del navegador móvil
      lastInnerWidth = window.innerWidth;
      resizedAt = performance.now();
    }, { passive: true });

    let lastWidth = track.clientWidth;
    new ResizeObserver(() => {
      if (track.clientWidth === lastWidth) return;
      lastWidth = track.clientWidth;
      measure();
    }).observe(track);

    measure();
    root.classList.add("is-ready");

    // Aparición escalonada al entrar en pantalla. La primera notificación del
    // observer dice dónde está la sección: si ya se ve (aunque sea en parte),
    // no se anima; si está más abajo, se oculta y aparece al llegar.
    if (!reduceMotion.matches && "IntersectionObserver" in window) {
      let first = true;
      const io = new IntersectionObserver(
        ([entry]) => {
          if (first) {
            first = false;
            if (entry.boundingClientRect.top < window.innerHeight) return io.disconnect();
            root.classList.add("is-pending");
            return;
          }
          if (entry.isIntersecting) {
            root.classList.add("is-revealed");
            requestAnimationFrame(() => root.classList.remove("is-pending"));
            io.disconnect();
          }
        },
        { threshold: 0.15 },
      );
      io.observe(root);
    }
  });
</script>
