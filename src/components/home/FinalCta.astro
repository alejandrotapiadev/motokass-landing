---
import { Image } from "astro:assets";
import bg from "../../assets/img/backgrounds/tienda.png";
---

<section class="fcta" aria-labelledby="fcta-title">
  <Image src={bg} alt="" widths={[640, 1280]} sizes="100vw" loading="lazy" class="fcta__bg" />
  <div class="container fcta__inner">
    <h2 id="fcta-title" class="display">¿Buscas tu próxima moto?</h2>
    <p>Ven a verla, pruébala y encuentra el equipamiento que necesitas.</p>
    <div class="fcta__ctas">
      <a href="/catalogo" class="btn btn--accent">Ver motos</a>
      <a href="/equipamiento" class="btn btn--light">Ver equipamiento</a>
    </div>
  </div>
</section>

<style>
.fcta {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--ink);
  color: #fff;
  text-align: center;
  padding: clamp(4rem, 10vw, 8rem) 0;
}
.fcta__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  z-index: -2;
}
.fcta::after { content: ""; position: absolute; inset: 0; background: rgba(14,15,18,.72); z-index: -1; }
.fcta h2 { font-size: clamp(2.8rem, 7vw, 5.5rem); margin: 0 0 1rem; }
.fcta p { font-size: 1.15rem; color: rgba(255,255,255,.85); margin: 0 auto 2.25rem; max-width: 46ch; }
.fcta__ctas { display: flex; justify-content: center; gap: .75rem; flex-wrap: wrap; }
@media (max-width: 560px) { .fcta__ctas .btn { flex: 1 1 100%; } }
</style>
