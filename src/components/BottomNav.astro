---
import Icon from "./ui/Icon.astro";
import CartCount from "./commerce/CartCount";
import { whatsappUrl } from "../lib/site";

const path = Astro.url.pathname.toLowerCase();
const wa = whatsappUrl();
const items = [
  { label: "Motos", href: "/catalogo", icon: "moto", active: path.startsWith("/catalogo") },
  { label: "Tienda", href: "/equipamiento", icon: "helmet", active: path.startsWith("/equipamiento") },
];
---

<nav class="bottom-nav" aria-label="Accesos rápidos">
  {items.map((i) => (
    <a href={i.href} class:list={["bn-item", { "is-active": i.active }]} aria-current={i.active ? "page" : undefined}>
      <Icon name={i.icon} size={24} />
      <span>{i.label}</span>
    </a>
  ))}
  <a href={wa} class="bn-item bn-item--wa" target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-track-location="bottom_nav">
    <Icon name="whatsapp" size={23} />
    <span>WhatsApp</span>
  </a>
  <a href="/carrito" class:list={["bn-item", { "is-active": path === "/carrito" }]}>
    <span class="bn-cart">
      <Icon name="cart" size={24} />
      <CartCount client:idle />
    </span>
    <span>Carrito</span>
  </a>
</nav>

<style>
.bottom-nav { display: none; }

@media (max-width: 900px) {
  .bottom-nav {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 450;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: calc(var(--bottom-nav-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ink);
    border-top: 1px solid var(--line-dark);
  }
  .bn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--text-inv-2);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .bn-item.is-active { color: #fff; box-shadow: inset 0 3px 0 var(--accent); }
  .bn-item--wa { color: var(--whatsapp); }
  .bn-cart { position: relative; display: inline-flex; }
  .bn-cart :global(span[aria-hidden]) { top: -6px !important; right: -10px !important; }
}
</style>
