---
// Reemplaza con reseñas reales cuando las tengas.
// También puedes enlazar a las reseñas de Google Maps del negocio.
const reseñas = [
  {
    nombre: "Carlos M.",
    texto: "Llevé mi Sherco 300 para la revisión anual y quedé muy contento. Rápidos, profesionales y el precio fue justo. Ya tengo mi taller de confianza en Ávila.",
    estrellas: 5,
    fecha: "Abril 2026",
  },
  {
    nombre: "Ana R.",
    texto: "Compré la Rieju Aventura 125 aquí y me asesoraron genial. Sin presión, resolvieron todas mis dudas y el trámite de la matrícula fue rapidísimo. 100% recomendable.",
    estrellas: 5,
    fecha: "Marzo 2026",
  },
  {
    nombre: "Pablo S.",
    texto: "Diagnóstico electrónico muy completo. Me explicaron exactamente qué necesitaba sin intentar venderme nada extra. Trato honesto y profesional.",
    estrellas: 5,
    fecha: "Febrero 2026",
  },
];

const googleMapsReviewsUrl =
  "https://www.google.com/maps/place/Moto+Kass/@40.6525761,-4.6877108,17z/data=!3m1!4b1!4m6!3m5!1s0xd40f313ac754745:0xcfeb50ee9c5664c1!8m2!3d40.6525721!4d-4.6851359!16s%2Fg%2F11kl1070yk";
---

<section class="testimonios">
  <div class="container">
    <div class="section-header">
      <h2>Lo que dicen nuestros clientes</h2>
      <p>Más de 500 clientes satisfechos en Ávila y alrededores.</p>
    </div>

    <div class="cards">
      {reseñas.map((r) => (
        <div class="card">
          <div class="card__estrellas" aria-label={`${r.estrellas} estrellas`}>
            {"★".repeat(r.estrellas)}
          </div>
          <p class="card__texto">"{r.texto}"</p>
          <div class="card__autor">
            <div class="avatar">{r.nombre.charAt(0)}</div>
            <div>
              <strong>{r.nombre}</strong>
              <span>{r.fecha}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="cta-reviews">
      <a href={googleMapsReviewsUrl} target="_blank" rel="noopener noreferrer" class="btn-google">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Ver todas las reseñas en Google
      </a>
    </div>
  </div>
</section>

<style>
.testimonios {
  padding: 5rem 1.5rem;
  background: white;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: .5rem;
}

.section-header p {
  color: #64748b;
  font-size: 1rem;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.card {
  background: #f8fafc;
  border-radius: 14px;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  border: 1px solid #e5e7eb;
  transition: box-shadow .25s, transform .25s;
}

.card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,.08);
  transform: translateY(-3px);
}

.card__estrellas {
  color: #f59e0b;
  font-size: 1.1rem;
  letter-spacing: 2px;
}

.card__texto {
  color: #374151;
  font-size: .95rem;
  line-height: 1.7;
  flex: 1;
  font-style: italic;
}

.card__autor {
  display: flex;
  align-items: center;
  gap: .75rem;
}

.avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
  flex-shrink: 0;
}

.card__autor strong {
  display: block;
  font-size: .9rem;
  color: #1e293b;
}

.card__autor span {
  font-size: .78rem;
  color: #94a3b8;
}

.cta-reviews {
  text-align: center;
}

.btn-google {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .8rem 1.75rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  text-decoration: none;
  font-size: .9rem;
  font-weight: 600;
  color: #374151;
  background: white;
  transition: border-color .2s, box-shadow .2s;
}

.btn-google:hover {
  border-color: #94a3b8;
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
}
</style>
