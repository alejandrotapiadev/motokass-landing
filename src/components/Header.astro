---
import logo from "../assets/img/concept/logoHeaderPulido-Photoroom.png";
---

<header class="header">
  <div class="header-content">
    <div class="header-left">
      <img src={logo.src} alt="Logotipo Motokass" class="logo" />
      <a href="/"><h1>MOT<span class="highlight">O</span>KASS</h1></a>
    </div>
    <div class="header-right">
      <nav>
        <ul class="nav-links">
          <li><a href="/catalogo">Catálogo</a></li>
          <li><a href="/comparar">Comparar</a></li>
          <li><a href="/taller">Taller</a></li>
          <li><a href="/contacto">Contacto</a></li>
          <li><a href="/Ofertas">Ofertas</a></li>
        </ul>
      </nav>
      <a href="tel:+34920254044" class="btn-llamar" aria-label="Llamar a MOTOKASS">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        920 254 044
      </a>
    </div>
  </div>
</header>

<style>
header {
  background-color: var(--color-primary);
  width: 100%;
}

.header-content {
  width: 100%;
  display: flex;
  justify-content: space-around;
}

.header-left {
  width: 40%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header-left img {
  width: 100px;
  height: auto;
}

.header-left h1 {
  margin-left: 0.5em;
  margin-bottom: 0;
  color: var(--color-white);
}

.header-left span {
  color: var(--color-white);
}

.header-right {
  width: 45%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 6rem;
  margin: 0;
  padding: 0;
}

.nav-links a {
  text-decoration: none;
  font-weight: 500;
  font-size: 1.3rem;
  color: var(--color-white);
  position: relative;
  padding: 5px 0;
  transition: color 0.3s ease;
}

.nav-links a:hover {
  opacity: 0.5;
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 0%;
  height: 2px;
  background-color: var(--color-white);
  transition: width 0.3s ease;
}

.nav-links a:hover::after {
  width: 100%;
}

.btn-llamar {
  display: none;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    align-items: center;
    padding: 1rem 0 0.75rem;
  }

  .header-left,
  .header-right {
    width: 100%;
    justify-content: center;
  }

  .header-right {
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-links {
    gap: 1.5rem;
  }

  .nav-links a {
    font-size: 0.9rem;
  }

  .btn-llamar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #16a34a;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    letter-spacing: 0.01em;
    box-shadow: 0 2px 10px rgba(22, 163, 74, 0.4);
    transition: background 0.2s, transform 0.15s;
    margin-bottom: 0.25rem;
  }

  .btn-llamar:hover {
    background: #15803d;
    transform: scale(1.03);
  }

  .btn-llamar:active {
    transform: scale(0.98);
  }
}
</style>
