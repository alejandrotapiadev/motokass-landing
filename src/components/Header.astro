---
import logo from "../assets/img/concept/logoHeaderPulido-Photoroom.png";
---

<header class="header">
  <div class="header-content">
    <div class="header-left">
      <img src={logo.src} alt="Logotipo Motokass" class="logo" />
      <a href="/"><h1>MOT<span class="highlight">O</span>KASS</h1></a>
    </div>
    <div class="header-right">
      <nav>
        <ul class="nav-links">
          <li><a href="/catalogo">Catálogo</a></li>
          <li><a href="/taller">Taller</a></li>
          <li><a href="/contacto">Contacto</a></li>
          <li><a href="/Ofertas">Ofertas</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
header {
  background-color: var(--color-primary);
  width: 100%;
}

.header-content {
  width: 100%;
  display: flex;
  justify-content: space-around;
}

.header-left {
  width: 40%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header-left img {
  width: 100px;
  height: auto;
}

.header-left h1 {
  margin-left: 0.5em;
  margin-bottom: 0;
  color: var(--color-white);
}

.header-left span {
  color: var(--color-white);
}

.header-right {
  width: 45%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 6rem;
  margin: 0;
  padding: 0;
}

.nav-links a {
  text-decoration: none;
  font-weight: 500;
  font-size: 1.3rem;
  color: var(--color-white);
  position: relative;
  padding: 5px 0;
  transition: color 0.3s ease;
}

.nav-links a:hover {
  opacity: 0.5;
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 0%;
  height: 2px;
  background-color: var(--color-white);
  transition: width 0.3s ease;
}

.nav-links a:hover::after {
  width: 100%;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
  }

  .header-left,
  .header-right {
    width: 100%;
    justify-content: center;
  }

  .nav-links {
    gap: 1.5rem;
  }

  .nav-links a {
    font-size: 0.9rem;
  }
}
</style>
