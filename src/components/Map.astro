---
const lat = 40.6525721;
const lng = -4.6851359;
const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
const embedUrl = `https://www.google.com/maps?q=${lat},${lng}&hl=es&z=17&output=embed`;
---

<section class="location-section">
  <div class="container">
    <div class="location-content">

      <div class="location-text">
        <h2>Dónde estamos</h2>
        <p>
          Encuentra nuestro taller fácilmente en el centro de Ávila.
          Atención personalizada y aparcamiento disponible.
        </p>

        <div class="info-lista">
          <div class="info-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>C. de la Virgen María, 20, Ávila 05003</span>
          </div>
          <div class="info-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.49 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.22 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+34920254044">+34 920 254 044</a>
          </div>
          <div class="info-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Lun–Jue: 10:00–13:45 y 15:30–19:00 &nbsp;·&nbsp; Vie: 10:00–14:00</span>
          </div>
        </div>

        <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-route">
          Iniciar ruta en Google Maps
        </a>
      </div>

      <div class="map-wrapper">
        <iframe
          src={embedUrl}
          title="Ubicación de MOTOKASS en Google Maps"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

    </div>
  </div>
</section>

<style>
.location-section {
  background: var(--color-gray-light);
  padding: 5rem 2rem;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
}

.location-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.location-text h2 {
  font-size: 2rem;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 1rem;
}

.location-text > p {
  color: #64748b;
  margin-bottom: 2rem;
  line-height: 1.7;
}

.info-lista {
  display: flex;
  flex-direction: column;
  gap: .9rem;
  margin-bottom: 2rem;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: .65rem;
  font-size: .9rem;
  color: #374151;
  line-height: 1.5;
}

.info-item svg {
  color: var(--color-primary);
  flex-shrink: 0;
  margin-top: .1rem;
}

.info-item a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 600;
}

.info-item a:hover { text-decoration: underline; }

.btn-route {
  display: inline-block;
  background: var(--color-primary);
  color: white;
  padding: .85rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
  font-size: .95rem;
  transition: filter .2s, transform .15s;
}

.btn-route:hover {
  filter: brightness(1.1);
  transform: translateY(-2px);
}

.map-wrapper {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 15px 40px rgba(0,0,0,.1);
  height: 420px;
}

.map-wrapper iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

@media (max-width: 900px) {
  .location-content { grid-template-columns: 1fr; }
  .map-wrapper { height: 320px; }
}
</style>
