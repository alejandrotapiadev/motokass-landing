---
import tiendaBg from "../assets/img/backgrounds/tienda.png";
import tallerBg from "../assets/img/backgrounds/taller.png";
---

<section class="section fade-in">
  <div class="container">
    <div class="services">
      <a
        href="/tienda"
        class="service-card"
        style={`background-image: url('${tiendaBg.src}')`}
      >
        <h1>TIENDA</h1>
      </a>

      <a
        href="/taller"
        class="service-card"
        style={`background-image: url('${tallerBg.src}')`}
      >
        <h1>TALLER</h1>
      </a>
    </div>
  </div>
</section>

<style>
.services {
  display: flex;
  justify-content: space-around;
  gap: 2%;
}

.service-card {
  background-color: var(--color-primary);
  text-align: center;
  width: 48%;
  text-decoration: none;
  padding: 2em;
  font-size: 2em;
  height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 16px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  background-size: cover;
  background-position: center;
}

.service-card h1 {
  color: var(--color-white);
  font-size: 5em;
  position: relative;
  display: inline-block;
  cursor: pointer;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}

.service-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

@media (max-width: 768px) {
  .services {
    flex-direction: column;
    gap: 1rem;
  }

  .service-card {
    width: 100%;
    height: 45vh;
  }

  .service-card h1 {
    font-size: 3em;
  }
}
</style>
