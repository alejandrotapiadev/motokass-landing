---
import { Image } from "astro:assets";
import logo from "../assets/img/brand/logo-mk.png";
import Icon from "./ui/Icon.astro";
import { getActiveCategories, categoryUrl } from "../lib/catalog/equipment-categories";
import { getHelpTopics } from "../lib/commerce/help-topics";
import { SITE, whatsappUrl, BLOG_ENABLED } from "../lib/site";

const categories = getActiveCategories();
const helpTopics = getHelpTopics();

const columns = [
  {
    title: "Motos",
    links: [
      { label: "Catálogo", href: "/catalogo" },
      { label: "Ofertas", href: "/Ofertas" },
      { label: "Comparar", href: "/comparar" },
      { label: "Reservar prueba", href: "/CitaPrevia?motivo=prueba" },
    ],
  },
  {
    title: "Equipamiento",
    links: categories.map((c) => ({ label: c.name, href: categoryUrl(c.slug) })),
  },
  {
    title: "Taller",
    links: [
      { label: "Servicios", href: "/taller" },
      { label: "Pedir cita", href: "/CitaPrevia" },
    ],
  },
  {
    title: "MOTOKASS",
    links: [
      { label: "Contacto", href: "/contacto" },
      { label: "Preguntas frecuentes", href: "/faq" },
      ...(BLOG_ENABLED ? [{ label: "Blog", href: "/blog" }] : []),
    ],
  },
  {
    title: "Ayuda",
    links: [
      ...helpTopics.map((t) => ({ label: t.title, href: `/ayuda/${t.slug}` })),
      { label: "Contacto", href: "/contacto" },
      { label: "WhatsApp", href: whatsappUrl(), external: true },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="MOTOKASS, inicio">
        <Image src={logo} alt="" width={44} height={44} />
        <span>MOTO<span>KASS</span></span>
      </a>
      <p>Concesionario oficial Rieju &amp; Sherco, equipamiento para motoristas y taller propio en Ávila.</p>
      <ul class="footer__contact">
        <li><Icon name="pin" size={16} /> {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}</li>
        <li><Icon name="phone" size={16} /> <a href={`tel:${SITE.phone}`} data-track="click_call" data-track-location="footer">{SITE.phoneDisplay}</a></li>
        <li><Icon name="doc" size={16} /> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <ul class="footer__hours">
        {SITE.schedule.map((s) => <li><span>{s.days}</span><strong>{s.hours}</strong></li>)}
      </ul>
      <div class="footer__social">
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7Zm10 2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h10Zm-5 3.5A4.5 4.5 0 1 0 16.5 12 4.5 4.5 0 0 0 12 7.5Zm0 7.3A2.8 2.8 0 1 1 14.8 12 2.8 2.8 0 0 1 12 14.8Zm4.7-7.8a1 1 0 1 0 1 1 1 1 0 0 0-1-1Z"/></svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-3h2V9.5c0-2 1.2-3.1 3-3.1.9 0 1.8.1 1.8.1v2h-1c-1 0-1.3.6-1.3 1.2V12h2.3l-.4 3h-1.9v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__cols" aria-label="Pie de página">
      {columns.map((col) => (
        <div class="footer__col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} {...((l as any).external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {new Date().getFullYear()} MOTOKASS. Todos los derechos reservados.</p>
      <p class="footer__legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/cookies">Cookies</a>
        <a href="/condiciones-venta">Condiciones de venta</a>
      </p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--ink);
  color: var(--text-inv-2);
  font-size: .9rem;
  padding-top: 4rem;
}
.footer a:hover { color: #fff; }
.footer__top {
  display: grid;
  grid-template-columns: minmax(260px, 1.1fr) 3fr;
  gap: 3rem;
}
.footer__logo { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
.footer__logo > span {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: .04em;
  color: #fff;
}
.footer__logo > span span { color: var(--brand-2); }
.footer__brand p { line-height: 1.6; margin: 0 0 1.25rem; max-width: 36ch; }
.footer__contact, .footer__hours { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: .5rem; }
.footer__contact li { display: flex; align-items: center; gap: .55rem; }
.footer__hours li { display: flex; justify-content: space-between; gap: 1rem; max-width: 320px; font-size: .85rem; }
.footer__hours strong { color: var(--text-inv); font-weight: 600; }
.footer__social { display: flex; gap: .5rem; }
.footer__social a {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid var(--line-dark);
  border-radius: var(--radius);
  color: var(--text-inv);
}
.footer__social a:hover { border-color: #fff; }

.footer__cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2rem; }
.footer__col h2 {
  font-family: var(--font-body);
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #fff;
  margin: 0 0 1rem;
}
.footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }

.footer__bottom { border-top: 1px solid var(--line-dark); margin-top: 3.5rem; }
.footer__bottom-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  font-size: .8rem;
}
.footer__bottom p { margin: 0; }
.footer__legal { display: flex; gap: 1.25rem; }

@media (max-width: 1080px) {
  .footer__top { grid-template-columns: 1fr; }
  .footer__cols { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
  .footer { padding-top: 3rem; }
  .footer__cols { grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1rem; }
}
</style>
