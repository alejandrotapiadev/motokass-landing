---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import StoreTrust from "../../components/commerce/StoreTrust.astro";
import EquipmentListing from "../../components/commerce/EquipmentListing";
import { getEquipment } from "../../lib/catalog/equipment";
import { ALL_SIZES, getActiveCategories } from "../../lib/catalog/equipment-categories";
import { whatsappUrl } from "../../lib/site";

const { products, source } = await getEquipment();
const categories = getActiveCategories().map(({ slug, name, icon }) => ({ slug, name, icon }));
---

<MainLayout
  title="Equipamiento para motoristas en Ávila | Cascos, guantes, chaquetas y botas | MOTOKASS"
  description="Tienda de equipamiento para motoristas en Ávila: cascos, guantes, chaquetas, camisetas y botas. Asesoramiento en tienda física, taller propio y atención por WhatsApp."
  noindex={source === "mock"}
>
  <section class="eq-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Equipamiento" }]} class="eq-hero__crumbs" />
      <h1 class="display">Equipamiento<br />para motoristas</h1>
      <p>Cascos, guantes, chaquetas, camisetas y botas para salir en moto con seguridad y estilo. Te asesoramos en nuestra tienda de Ávila.</p>
    </div>
  </section>

  <StoreTrust />

  <section class="eq-body">
    <div class="container">
      {source === "mock" && <p class="dev-mock-banner">Datos DEMO de desarrollo — no son productos reales</p>}

      <EquipmentListing
        client:load
        products={products}
        categories={categories}
        categorySlug={null}
        categoryName="Productos"
        types={[]}
        sizeScale={ALL_SIZES}
        initialQuery={Astro.url.searchParams.toString()}
        helpUrl={whatsappUrl("Hola, quería consultar por equipamiento: ")}
      />
    </div>
  </section>
</MainLayout>

<style>
.eq-hero { background: var(--ink); color: #fff; padding: 2rem 0 3rem; }
.eq-hero :global(.eq-hero__crumbs ol) { color: var(--text-inv-2); }
.eq-hero :global(.eq-hero__crumbs [aria-current]) { color: #fff; }
.eq-hero h1 { font-size: clamp(3rem, 8vw, 6rem); margin: 1.5rem 0 1rem; }
.eq-hero p { color: var(--text-inv-2); max-width: 56ch; font-size: 1.05rem; line-height: 1.6; margin: 0; }
.eq-body { padding: 2rem 0 4rem; }
</style>
