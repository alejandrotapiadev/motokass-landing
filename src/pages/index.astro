---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/home/Hero.astro";
import TrustBar from "../components/home/TrustBar.astro";
import EquipmentCategories from "../components/home/EquipmentCategories.astro";
import FeaturedEquipment from "../components/home/FeaturedEquipment.astro";
import FeaturedMotorcycles from "../components/home/FeaturedMotorcycles.astro";
import MotoSegments from "../components/home/MotoSegments.astro";
import OffersTabs from "../components/offers/OffersTabs.astro";
import FinanceTestRide from "../components/home/FinanceTestRide.astro";
import WhyMotokass from "../components/home/WhyMotokass.astro";
import WorkshopTeaser from "../components/home/WorkshopTeaser.astro";
import Reviews from "../components/home/Reviews.astro";
import Location from "../components/home/Location.astro";
import BlogTeaser from "../components/home/BlogTeaser.astro";
import FinalCta from "../components/home/FinalCta.astro";
import Icon from "../components/ui/Icon.astro";
---

<MainLayout
  title="MOTOKASS | Motos Rieju y Sherco, equipamiento y taller en Ávila"
  description="Concesionario oficial Rieju y Sherco en Ávila: más de 60 motos, financiación, prueba de moto, equipamiento para motoristas y taller propio."
>
  <Hero />
  <TrustBar />
  <EquipmentCategories />
  <FeaturedEquipment />
  <FeaturedMotorcycles />
  <MotoSegments />

  <section class="section" aria-labelledby="offers-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Promociones</span>
          <h2 id="offers-title">Ofertas MOTOKASS</h2>
        </div>
        <a href="/Ofertas" class="link-arrow">Todas las ofertas <Icon name="arrow-right" size={14} /></a>
      </div>
      <OffersTabs id="home-offers" limit={4} />
    </div>
  </section>

  <FinanceTestRide />
  <WhyMotokass />
  <WorkshopTeaser />
  <Reviews />
  <Location />
  <BlogTeaser />
  <FinalCta />
</MainLayout>
