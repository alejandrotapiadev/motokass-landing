---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import { getDynamicPostBySlug, getDynamicPosts, type DynamicPost } from "../../lib/supabaseBlog";
import { readingTime, readingTimeFromHtml } from "../../lib/readingTime";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/blog");

// ── Buscar primero en posts estáticos (.md) ──────────────────────────────────
const staticPosts = await getCollection("blog");
const staticPost  = staticPosts.find((p) => p.id.replace(/\.md$/, "") === slug);

// ── Si no está, buscar en Supabase ────────────────────────────────────────────
let dynamicPost: DynamicPost | null = null;
if (!staticPost) {
  dynamicPost = await getDynamicPostBySlug(slug);
  if (!dynamicPost) return Astro.redirect("/404");
}

// ── Datos comunes ─────────────────────────────────────────────────────────────
const title       = staticPost ? staticPost.data.title       : dynamicPost!.title;
const description = staticPost ? staticPost.data.description : dynamicPost!.description;
const image       = staticPost ? staticPost.data.image       : dynamicPost!.image;
const imageAlt    = staticPost ? staticPost.data.imageAlt    : dynamicPost!.image_alt;
const category    = staticPost ? staticPost.data.category    : dynamicPost!.category;
const author      = staticPost ? staticPost.data.author      : dynamicPost!.author;
const tags        = staticPost ? staticPost.data.tags        : dynamicPost!.tags;
const date        = staticPost ? staticPost.data.date        : new Date(dynamicPost!.published_at);
const minutos     = staticPost
  ? readingTime(staticPost.body ?? "")
  : readingTimeFromHtml(dynamicPost!.content);

// ── Renderizado (solo para posts estáticos) ───────────────────────────────────
let StaticContent: any = null;
if (staticPost) {
  const rendered = await render(staticPost);
  StaticContent  = rendered.Content;
}

// ── Posts relacionados (misma categoría, otra fuente combinada) ───────────────
const allStatic  = staticPosts
  .filter((p) => p.id.replace(/\.md$/, "") !== slug && p.data.category === category)
  .map((p) => ({
    slug:  p.id.replace(/\.md$/, ""),
    title: p.data.title,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
    category: p.data.category,
    date:  p.data.date,
  }));

const allDynamic = (await getDynamicPosts(category))
  .filter((p) => p.slug !== slug)
  .map((p) => ({
    slug:     p.slug,
    title:    p.title,
    image:    p.image,
    imageAlt: p.image_alt,
    category: p.category,
    date:     new Date(p.published_at),
  }));

const relacionados = [...allDynamic, ...allStatic]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 2);

// ── Helpers ───────────────────────────────────────────────────────────────────
function formatFecha(d: Date) {
  return d.toLocaleDateString("es-ES", {
    day: "numeric", month: "long", year: "numeric",
  });
}

const CATEGORY_COLORS: Record<string, string> = {
  Novedades:     "#dc2626",
  Mantenimiento: "#0891b2",
  Rutas:         "#16a34a",
  Consejos:      "#7c3aed",
};

const catColor  = CATEGORY_COLORS[category] ?? "#1F3F7A";
const postUrl   = `https://motokass.com/blog/${slug}`;
---

<MainLayout
  title={`${title} | Blog MOTOKASS`}
  description={description}
  ogImage={image}
>
  <slot name="head" slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author"         content={author} />
    <meta property="article:section"        content={category} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </slot>

  <!-- HERO -->
  <div class="post-hero" style={`background-image:url('${image}')`} role="img" aria-label={imageAlt}>
    <div class="post-hero__overlay">
      <div class="container">
        <nav class="breadcrumb" aria-label="Migas de pan">
          <a href="/">Inicio</a><span>/</span>
          <a href="/blog">Blog</a><span>/</span>
          <span aria-current="page">{category}</span>
        </nav>
        <div class="post-hero__content">
          <span class="cat-pill" style={`background:${catColor}`}>{category}</span>
          <h1>{title}</h1>
          <div class="post-meta">
            <time datetime={date.toISOString()}>{formatFecha(date)}</time>
            <span class="sep">·</span>
            <span>{minutos} min de lectura</span>
            <span class="sep">·</span>
            <span>Por {author}</span>
            {dynamicPost && <><span class="sep">·</span><span class="auto-tag">⚡ IA</span></>}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTENIDO -->
  <div class="post-layout">
    <div class="container post-container">

      <article class="prose">
        {staticPost && StaticContent
          ? <StaticContent />
          : <Fragment set:html={dynamicPost!.content} />
        }
      </article>

      <!-- COMPARTIR -->
      <div class="share-section">
        <span class="share-label">Compartir:</span>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(title + " " + postUrl)}`}
          target="_blank" rel="noopener noreferrer"
          class="share-btn share-btn--whatsapp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <button id="copy-link" class="share-btn share-btn--copy" data-url={postUrl}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-text">Copiar enlace</span>
        </button>
      </div>

      <!-- TAGS -->
      {tags.length > 0 && (
        <div class="tags-section">
          {tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}

      <!-- CTA -->
      <div class="post-cta">
        <div class="post-cta__inner">
          <div class="post-cta__text">
            <h3>¿Te quedaron dudas?</h3>
            <p>Nuestro equipo en Ávila está encantado de ayudarte. Llámanos, escríbenos o ven a vernos.</p>
          </div>
          <div class="post-cta__actions">
            <a href="/CitaPrevia" class="cta-btn cta-btn--primary">Agendar cita</a>
            <a href="/contacto"   class="cta-btn cta-btn--secondary">Contactar</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- RELACIONADOS -->
  {relacionados.length > 0 && (
    <section class="relacionados">
      <div class="container">
        <h2 class="relacionados__title">También puede interesarte</h2>
        <div class="relacionados__grid">
          {relacionados.map((rel) => (
            <a href={`/blog/${rel.slug}`} class="rel-card">
              <div class="rel-card__img">
                <img src={rel.image} alt={rel.imageAlt} loading="lazy" decoding="async" />
              </div>
              <div class="rel-card__body">
                <span class="cat-pill cat-pill--sm" style={`background:${CATEGORY_COLORS[rel.category]}`}>
                  {rel.category}
                </span>
                <h3>{rel.title}</h3>
                <span class="read-more">Leer artículo →</span>
              </div>
            </a>
          ))}
        </div>
        <div class="relacionados__cta">
          <a href="/blog" class="btn-ver-todos">← Volver al blog</a>
        </div>
      </div>
    </section>
  )}

  {relacionados.length === 0 && (
    <div class="back-to-blog">
      <div class="container">
        <a href="/blog" class="btn-ver-todos">← Volver al blog</a>
      </div>
    </div>
  )}

</MainLayout>

<script>
  const copyBtn  = document.getElementById("copy-link") as HTMLButtonElement | null;
  const copyText = document.getElementById("copy-text");
  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", async () => {
      const url = copyBtn.getAttribute("data-url") ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        copyText.textContent = "¡Copiado!";
        setTimeout(() => (copyText.textContent = "Copiar enlace"), 2500);
      } catch {
        copyText.textContent = "Error al copiar";
      }
    });
  }
</script>

<style>
.post-hero { background-size: cover; background-position: center; position: relative; }
.post-hero__overlay {
  background: linear-gradient(to bottom, rgba(10,20,45,0.55) 0%, rgba(10,20,45,0.75) 100%);
  padding: 3rem 0 3.5rem;
}
.breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: rgba(255,255,255,0.65); margin-bottom: 2rem; }
.breadcrumb a { color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s; }
.breadcrumb a:hover { color: white; }
.post-hero__content { max-width: 780px; display: flex; flex-direction: column; gap: 1rem; }
.post-hero__content h1 { color: white; font-size: clamp(1.6rem, 3.5vw, 2.6rem); font-weight: 800; line-height: 1.2; margin: 0; }
.post-meta { display: flex; align-items: center; gap: 0.5rem; font-size: 0.84rem; color: rgba(255,255,255,0.7); flex-wrap: wrap; }
.sep { opacity: 0.5; }
.auto-tag { background: rgba(250,204,21,0.2); color: #fde68a; font-size: 0.72rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 4px; }
.cat-pill { display: inline-block; color: white; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.28rem 0.8rem; border-radius: 999px; width: fit-content; }
.cat-pill--sm { font-size: 0.68rem; padding: 0.22rem 0.65rem; }
.post-layout { padding: 3.5rem 0 2rem; background: #f8fafc; }
.post-container { max-width: 760px !important; }
.prose {
  background: white; border-radius: 16px; padding: 2.5rem 2.75rem;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06); font-size: 1rem; line-height: 1.8; color: #1e293b;
}
.prose :global(h2) { font-family: Poppins, sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--color-primary); margin: 2rem 0 0.9rem; line-height: 1.3; }
.prose :global(h3) { font-family: Poppins, sans-serif; font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 1.5rem 0 0.6rem; }
.prose :global(p)  { margin: 0 0 1.25rem; }
.prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1.25rem; }
.prose :global(li) { margin-bottom: 0.5rem; }
.prose :global(strong) { font-weight: 700; color: #0f172a; }
.prose :global(a) { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
.prose :global(a:hover) { color: var(--color-primary-dark); }
.prose :global(blockquote) { border-left: 4px solid var(--color-primary); margin: 1.5rem 0; padding: 0.75rem 1.25rem; background: #f0f4ff; border-radius: 0 8px 8px 0; font-style: italic; color: #334155; }
.prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; border-radius: 10px; overflow: hidden; border: 1px solid #e5e7eb; }
.prose :global(th) { background: #f8fafc; padding: 0.65rem 1rem; text-align: left; font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; border-bottom: 1px solid #e5e7eb; }
.prose :global(td) { padding: 0.65rem 1rem; border-bottom: 1px solid #f1f5f9; color: #374151; }
.prose :global(tr:last-child td) { border-bottom: none; }
.prose :global(hr) { border: none; border-top: 2px solid #f1f5f9; margin: 2.5rem 0; }
.share-section { display: flex; align-items: center; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
.share-label { font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em; }
.share-btn { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.82rem; font-weight: 700; text-decoration: none; cursor: pointer; border: 1.5px solid transparent; transition: all 0.15s; }
.share-btn--whatsapp { background: #25d366; color: white; }
.share-btn--whatsapp:hover { filter: brightness(0.9); }
.share-btn--copy { background: white; color: var(--color-primary); border-color: #e5e7eb; }
.share-btn--copy:hover { border-color: var(--color-primary); background: #f0f4ff; }
.tags-section { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
.tag { background: #f1f5f9; color: #475569; font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.75rem; border-radius: 999px; }
.post-cta { margin-top: 2rem; }
.post-cta__inner { background: linear-gradient(135deg, #142C57 0%, #1F3F7A 100%); border-radius: 16px; padding: 2rem 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
.post-cta__text h3 { color: white; font-size: 1.2rem; margin-bottom: 0.4rem; }
.post-cta__text p  { color: rgba(255,255,255,0.75); font-size: 0.9rem; margin: 0; }
.post-cta__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; flex-shrink: 0; }
.cta-btn { padding: 0.7rem 1.4rem; border-radius: 8px; font-size: 0.9rem; font-weight: 700; text-decoration: none; transition: all 0.15s; display: inline-block; }
.cta-btn--primary { background: var(--color-secondary); color: white; }
.cta-btn--primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
.cta-btn--secondary { background: rgba(255,255,255,0.12); color: white; border: 1.5px solid rgba(255,255,255,0.3); }
.cta-btn--secondary:hover { background: rgba(255,255,255,0.2); }
.relacionados { background: white; padding: 3.5rem 0; border-top: 1px solid #f1f5f9; }
.relacionados__title { font-size: 1.35rem; font-weight: 800; color: var(--color-primary); margin-bottom: 1.75rem; }
.relacionados__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
.rel-card { display: flex; gap: 1.25rem; text-decoration: none; color: inherit; background: #f8fafc; border-radius: 14px; overflow: hidden; transition: box-shadow 0.2s, transform 0.15s; }
.rel-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
.rel-card__img { width: 130px; min-height: 100px; flex-shrink: 0; overflow: hidden; }
.rel-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rel-card__body { padding: 1rem 1rem 1rem 0; display: flex; flex-direction: column; gap: 0.5rem; justify-content: center; }
.rel-card__body h3 { font-size: 0.92rem; font-weight: 700; color: #0f172a; line-height: 1.35; margin: 0; }
.read-more { font-size: 0.82rem; font-weight: 700; color: var(--color-primary); }
.relacionados__cta { margin-top: 2rem; }
.btn-ver-todos { display: inline-block; font-size: 0.9rem; font-weight: 700; color: var(--color-primary); text-decoration: none; padding: 0.65rem 1.25rem; border: 1.5px solid var(--color-primary); border-radius: 8px; transition: background 0.15s, color 0.15s; }
.btn-ver-todos:hover { background: var(--color-primary); color: white; }
.back-to-blog { padding: 2.5rem 0; background: white; border-top: 1px solid #f1f5f9; }
@media (max-width: 768px) {
  .prose { padding: 1.5rem 1.25rem; }
  .post-cta__inner { padding: 1.5rem 1.25rem; flex-direction: column; text-align: center; }
  .post-cta__actions { justify-content: center; }
  .relacionados__grid { grid-template-columns: 1fr; }
}
</style>
