---
import MainLayout from "../layouts/MainLayout.astro";
import ComparadorMotos from "../components/ComparadorMotos.jsx";
import RiejuCatalogo from "../resources/RiejuCatalogo.json";
import ShercoCatalogo from "../resources/ShercoCatalogo.json";

const motosRieju = (RiejuCatalogo.catalogo.modelos as any[]).map((moto) => ({
  marca:     RiejuCatalogo.catalogo.marca,
  nombre:    moto.modelo,
  imagen:    moto.imagen,
  specs:     moto.specs,
  stock:     moto.stock,
  nuevo:     moto.nuevo     ?? false,
  categoria: moto.categoria ?? null,
  año:       moto.año       ?? null,
}));

const motosSherco = (ShercoCatalogo.catalogo.modelos as any[]).map((moto) => ({
  marca:     ShercoCatalogo.catalogo.marca,
  nombre:    moto.modelo,
  imagen:    moto.imagen,
  specs:     moto.specs,
  stock:     moto.stock,
  nuevo:     moto.nuevo     ?? false,
  categoria: moto.categoria ?? null,
  año:       moto.año       ?? null,
}));

// Intercalado R1, S1, R2, S2… igual que en catálogo
const motos: any[] = [];
const maxLen = Math.max(motosRieju.length, motosSherco.length);
for (let i = 0; i < maxLen; i++) {
  if (i < motosRieju.length)  motos.push(motosRieju[i]);
  if (i < motosSherco.length) motos.push(motosSherco[i]);
}
---

<MainLayout
  title="Comparar Motos | MOTOKASS — Rieju y Sherco en Ávila"
  description="Compara las especificaciones de hasta 3 motos Rieju y Sherco lado a lado. Potencia, peso, cilindrada, depósito y mucho más."
>
  <section class="section">
    <div class="container">

      <div class="page-header">
        <h1>Comparador de motos</h1>
        <p>Selecciona hasta 3 modelos y compara sus especificaciones técnicas en detalle.</p>
        <a href="/catalogo" class="back-link">← Volver al catálogo</a>
      </div>

      <ComparadorMotos motos={motos} client:load />

    </div>
  </section>
</MainLayout>

<style>
.section {
  padding: 2.5rem 1.5rem 4rem;
  background: var(--color-gray-light, #f8fafc);
  min-height: 80vh;
}
.container {
  max-width: 1100px;
  margin: 0 auto;
}
.page-header {
  margin-bottom: 2rem;
}
.page-header h1 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: var(--color-primary, #1F3F7A);
  margin: 0 0 0.4rem;
}
.page-header p {
  color: #64748b;
  font-size: 1rem;
  margin: 0 0 1rem;
}
.back-link {
  font-size: 0.88rem;
  font-weight: 600;
  color: #1F3F7A;
  text-decoration: none;
  transition: opacity 0.15s;
}
.back-link:hover { opacity: 0.7; }
</style>
