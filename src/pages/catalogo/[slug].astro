---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Icon from "../../components/ui/Icon.astro";
import { getMotorcycleBySlug, MOTO_SEGMENTS } from "../../lib/catalog/motorcycles";
import { formatPriceRound, AVAILABILITY_SCHEMA } from "../../lib/catalog/types";
import { whatsappUrl, SITE } from "../../lib/site";

const { slug } = Astro.params;
const producto = getMotorcycleBySlug(slug ?? "");

if (!producto) {
  return Astro.rewrite("/404");
}

const marca = producto.brand;
const moto = {
  modelo: producto.name,
  specs: producto.specs as Record<string, string | number | boolean | null>,
  precio_eur: producto.price,
  imagen: producto.images[0] ?? "",
  stock: producto.availability !== "out_of_stock",
  categoria: producto.category ?? undefined,
};
const segmento = MOTO_SEGMENTS.find((s) => producto.segments.includes(s.slug));
const pruebaUrl = `/CitaPrevia?motivo=prueba&moto=${encodeURIComponent(moto.modelo)}`;
const wa = whatsappUrl(`Hola, me interesa la ${moto.modelo}. `);
const modelo = moto.modelo.toLowerCase().startsWith(marca.toLowerCase() + " ")
  ? moto.modelo.slice(marca.length + 1)
  : moto.modelo;

// Schema Motorcycle (subtipo de Product). Offer solo si hay PVP publicado.
const motoSchema = {
  "@context": "https://schema.org",
  "@type": "Motorcycle",
  name: moto.modelo,
  brand: { "@type": "Brand", name: marca },
  model: modelo,
  image: moto.imagen || undefined,
  category: [producto.category, producto.subcategory].filter(Boolean).join(" / ") || undefined,
  vehicleModelDate: producto.year ? String(producto.year) : undefined,
  url: new URL(producto.url, SITE.url).toString(),
  ...(producto.price != null
    ? {
        offers: {
          "@type": "Offer",
          priceCurrency: "EUR",
          price: producto.price,
          availability: AVAILABILITY_SCHEMA[producto.availability],
          itemCondition: "https://schema.org/NewCondition",
          seller: { "@type": "MotorcycleDealer", name: SITE.name },
        },
      }
    : {}),
};

const specsLabels: Record<string, string> = {
  cilindrada_cc:       "Cilindrada",
  tipo_motor:          "Motor",
  potencia_cv:         "Potencia",
  potencia_kw:         "Potencia eléctrica",
  par_motor_nm:        "Par motor",
  transmision:         "Transmisión",
  refrigeracion:       "Refrigeración",
  peso_kg:             "Peso",
  altura_sillin_mm:    "Altura de sillín",
  deposito_litros:     "Depósito",
  neumatico_delantero: "Neumático delantero",
  neumatico_trasero:   "Neumático trasero",
  abs:                 "ABS",
  bateria_kwh:         "Batería",
  autonomia_km:        "Autonomía",
  velocidad_max_kmh:   "Velocidad máx.",
};

const specsOrder = [
  "cilindrada_cc", "tipo_motor", "potencia_cv", "potencia_kw", "par_motor_nm",
  "bateria_kwh", "autonomia_km", "velocidad_max_kmh",
  "transmision", "refrigeracion",
  "peso_kg", "altura_sillin_mm", "deposito_litros",
  "neumatico_delantero", "neumatico_trasero", "abs",
];

const specsVisibles = specsOrder
  .filter(k => k in moto.specs)
  .map(k => ({ k, v: (moto.specs as Record<string, unknown>)[k] }))
  .filter(({ v }) => v !== null && v !== undefined)
  .map(({ k, v }) => ({
    label: specsLabels[k] ?? k,
    valor: k === "cilindrada_cc"       ? `${v} cc`
         : k === "potencia_cv"         ? `${v} CV`
         : k === "potencia_kw"         ? `${v} kW`
         : k === "par_motor_nm"        ? `${v} Nm`
         : k === "peso_kg"             ? `${v} kg`
         : k === "altura_sillin_mm"    ? `${v} mm`
         : k === "deposito_litros"     ? `${v} L`
         : k === "bateria_kwh"         ? `${v} kWh`
         : k === "autonomia_km"        ? `${v} km`
         : k === "velocidad_max_kmh"   ? `${v} km/h`
         : k === "abs"                 ? (v ? "Sí" : "No")
         : String(v),
  }));
---

<MainLayout
  title={`${moto.modelo} | MOTOKASS`}
  description={`Ficha técnica de la ${moto.modelo}. Distribuidor oficial ${marca} en Ávila.${moto.precio_eur != null ? ` PVP ${formatPriceRound(moto.precio_eur)}.` : ""} Financiación, prueba de moto y taller propio en MOTOKASS.`}
  ogImage={moto.imagen}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(motoSchema)} />
  <div class="page-wrapper" data-moto={moto.modelo} data-marca={marca} data-precio={moto.precio_eur ?? ""}>
    <Breadcrumbs
      class="ficha-crumbs"
      items={[
        { label: "Inicio", href: "/" },
        { label: "Motos", href: "/catalogo" },
        ...(segmento ? [{ label: segmento.name, href: `/catalogo?segmento=${segmento.slug}` }] : []),
        { label: moto.modelo },
      ]}
    />

    <div class="ficha">
      <!-- Imagen -->
      <div class="ficha__imagen">
        <img src={moto.imagen} alt={moto.modelo} loading="eager" decoding="async" />
        {!moto.stock && <div class="badge-agotada">Sin stock</div>}
      </div>

      <!-- Detalles -->
      <div class="ficha__detalles">
        <span class={`marca-badge marca-badge--${marca.toLowerCase()}`}>{marca}</span>
        <h1>{moto.modelo}</h1>
        {moto.precio_eur != null ? (
          <div class="precio"><small>PVP</small> {formatPriceRound(moto.precio_eur)}</div>
        ) : (
          <div class="precio precio--ask">Consultar precio</div>
        )}
        <p class="precio-nota">Pregúntanos por la financiación, la disponibilidad y el precio final con matriculación.</p>

        <div class="ctas">
          <a href={pruebaUrl} class="btn btn--accent" data-track="book_test_ride" data-track-location="moto_detail" data-track-moto={moto.modelo}>
            <Icon name="key" size={18} /> Reservar prueba
          </a>
          <a href="#interes" class="btn btn--outline">{moto.stock ? "Contactar" : "Avisarme cuando esté"}</a>
          <a href={wa} class="ctas__wa" target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-track-location="moto_detail">
            <Icon name="whatsapp" size={18} /> Preguntar por WhatsApp
          </a>
        </div>

        <!-- Specs -->
        <div class="specs">
          <h2>Especificaciones técnicas</h2>
          <ul class="specs__lista">
            {specsVisibles.map(({ label, valor }) => (
              <li>
                <span class="specs__label">{label}</span>
                <span class="specs__valor">{valor}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- Formulario de interés -->
    <div class="interes-section" id="interes">
      <div class="interes-card">
        <h2>{moto.stock ? "¿Te interesa esta moto?" : "¿Quieres que te avisemos?"}</h2>
        <p>
          {moto.stock
            ? "Déjanos tus datos y nos ponemos en contacto contigo para resolver dudas, organizar una prueba o gestionar la compra."
            : "Dinos cómo contactarte y te avisamos en cuanto tengamos stock disponible."}
        </p>

        <div id="interes-success" class="alert alert--success" hidden aria-live="polite">
          Mensaje enviado. Te contactaremos lo antes posible.
        </div>
        <div id="interes-error" class="alert alert--error" hidden aria-live="polite"></div>

        <form id="interes-form" class="interes-form" novalidate>
          <input type="hidden" name="moto" value={moto.modelo} />

          <div class="form-row">
            <div class="form-group">
              <label for="i-nombre">Nombre <span class="req">*</span></label>
              <input type="text" id="i-nombre" name="name" required placeholder="Tu nombre" />
              <span class="field-error" id="i-nombre-error"></span>
            </div>
            <div class="form-group">
              <label for="i-email">Email <span class="req">*</span></label>
              <input type="email" id="i-email" name="email" required placeholder="tu@email.com" />
              <span class="field-error" id="i-email-error"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="i-telefono">Teléfono <span class="opt">(opcional)</span></label>
            <input type="tel" id="i-telefono" name="phone" placeholder="600 000 000" />
          </div>

          <div class="form-group">
            <label for="i-mensaje">Mensaje <span class="opt">(opcional)</span></label>
            <textarea id="i-mensaje" name="userMessage" rows="3" placeholder="¿Alguna pregunta o comentario?"></textarea>
          </div>

          <button type="submit" id="interes-btn" class="btn-primary">
            <span id="interes-btn-text">Enviar</span>
            <span id="interes-btn-loading" hidden>Enviando...</span>
          </button>
        </form>
      </div>
    </div>

  </div>
</MainLayout>

<script>
  import { track } from "../../lib/analytics";
  const wrapper = document.querySelector<HTMLElement>(".page-wrapper[data-moto]");
  if (wrapper) {
    track("view_motorcycle", {
      item_name: wrapper.dataset.moto,
      item_brand: wrapper.dataset.marca,
      price: wrapper.dataset.precio ? Number(wrapper.dataset.precio) : null,
      currency: "EUR",
    });
  }

  const form = document.getElementById("interes-form") as HTMLFormElement;
  const btn = document.getElementById("interes-btn") as HTMLButtonElement;
  const btnText = document.getElementById("interes-btn-text")!;
  const btnLoading = document.getElementById("interes-btn-loading")!;
  const successMsg = document.getElementById("interes-success")!;
  const errorMsg = document.getElementById("interes-error")!;

  function showFieldError(id: string, msg: string) {
    const err = document.getElementById(id);
    if (err) err.textContent = msg;
  }

  function clearErrors() {
    document.querySelectorAll<HTMLElement>(".field-error").forEach(el => (el.textContent = ""));
  }

  function validate(name: string, email: string): boolean {
    let ok = true;
    clearErrors();
    if (!name.trim()) { showFieldError("i-nombre-error", "Campo obligatorio"); ok = false; }
    if (!email.trim()) { showFieldError("i-email-error", "Campo obligatorio"); ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showFieldError("i-email-error", "Email no válido"); ok = false; }
    return ok;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successMsg.hidden = true;
    errorMsg.hidden = true;

    const fd = new FormData(form);
    const name = fd.get("name") as string;
    const email = fd.get("email") as string;
    const phone = fd.get("phone") as string;
    const motoNombre = fd.get("moto") as string;
    const userMessage = fd.get("userMessage") as string;

    if (!validate(name, email)) return;

    const message = `Me interesa la moto: ${motoNombre}.${userMessage?.trim() ? `\n\n${userMessage}` : ""}`;

    btn.disabled = true;
    btnText.hidden = true;
    btnLoading.hidden = false;

    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, phone, message }),
      });
      const json = await res.json();

      if (res.ok) {
        form.reset();
        successMsg.hidden = false;
        successMsg.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        errorMsg.textContent = json.error || "Error al enviar. Inténtalo de nuevo.";
        errorMsg.hidden = false;
      }
    } catch {
      errorMsg.textContent = "Error de conexión. Inténtalo de nuevo.";
      errorMsg.hidden = false;
    } finally {
      btn.disabled = false;
      btnText.hidden = false;
      btnLoading.hidden = true;
    }
  });
</script>

<style>
.page-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}

.page-wrapper :global(.ficha-crumbs) { margin-bottom: 2rem; }

.precio small { font-size: .8rem; color: var(--text-2); letter-spacing: .1em; }
.precio--ask { font-size: 1.5rem; }
.precio-nota { margin: -.5rem 0 0; font-size: .85rem; color: var(--text-2); }
.ctas { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
.ctas__wa { display: inline-flex; align-items: center; gap: .4rem; font-size: .88rem; font-weight: 600; color: #128c4a; padding: .5rem 0; }
.ctas__wa:hover { text-decoration: underline; }

/* FICHA GRID */
.ficha {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  margin-bottom: 3rem;
}

.ficha__imagen {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--line);
  aspect-ratio: 4/3;
}

.ficha__imagen img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.badge-agotada {
  position: absolute;
  top: 14px;
  right: 14px;
  background: #6b7280;
  color: white;
  font-size: .8rem;
  font-weight: 700;
  padding: .3rem .8rem;
  border-radius: 999px;
  text-transform: uppercase;
}

/* DETALLES */
.ficha__detalles {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.marca-badge {
  display: inline-block;
  font-size: .75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .5px;
  padding: .25rem .65rem;
  border-radius: 999px;
  color: white;
  width: fit-content;
}

.marca-badge--rieju  { background: #dc2626; }
.marca-badge--sherco { background: #0d9488; }

.ficha__detalles h1 {
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  font-weight: 800;
  text-transform: uppercase;
  color: var(--text);
  line-height: 1;
  margin: 0;
}

.precio {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--text);
}

/* SPECS */
.specs h2 {
  font-size: 1rem;
  font-weight: 700;
  color: #374151;
  margin-bottom: .75rem;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.specs__lista {
  list-style: none;
  padding: 0;
  margin: 0;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  overflow: hidden;
}

.specs__lista li {
  display: flex;
  justify-content: space-between;
  padding: .65rem 1rem;
  font-size: .9rem;
}

.specs__lista li:nth-child(even) { background: #f8fafc; }

.specs__label { font-weight: 600; color: #555; }
.specs__valor { color: #1e293b; }

/* BUTTONS */
.btn-primary {
  display: block;
  text-align: center;
  padding: .9rem 1.5rem;
  background: var(--color-primary);
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: filter .2s, transform .15s;
}

.btn-primary:hover:not(:disabled) { filter: brightness(1.1); transform: translateY(-1px); }
.btn-primary:disabled { opacity: .7; cursor: not-allowed; }

.btn-primary--outline {
  background: transparent;
  border: 2px solid var(--color-primary);
  color: var(--color-primary);
}

.btn-primary--outline:hover { background: var(--color-primary); color: white; }

.btn-secondary {
  display: block;
  text-align: center;
  padding: .85rem 1.5rem;
  background: transparent;
  color: #64748b;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  font-size: .95rem;
  font-weight: 600;
  text-decoration: none;
  transition: border-color .2s, color .2s;
}

.btn-secondary:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* INTERÉS */
.interes-section {
  max-width: 680px;
  margin: 0 auto;
}

.interes-card {
  background: white;
  border-radius: 16px;
  padding: 2.5rem 2rem;
  box-shadow: 0 4px 24px rgba(0,0,0,.07);
}

.interes-card h2 {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: .5rem;
}

.interes-card > p {
  color: #64748b;
  margin-bottom: 1.75rem;
  line-height: 1.6;
}

.alert {
  padding: 1rem 1.25rem;
  border-radius: 10px;
  margin-bottom: 1.5rem;
  font-size: .9rem;
  font-weight: 500;
}

.alert--success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
.alert--error   { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

.interes-form { display: flex; flex-direction: column; gap: 1.1rem; }

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-group { display: flex; flex-direction: column; }

label {
  font-size: .85rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: .35rem;
}

.req { color: #dc2626; }
.opt { font-weight: 400; color: #9ca3af; font-size: .78rem; }

input, textarea {
  padding: .7rem .9rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  font-size: .95rem;
  transition: border-color .2s;
  box-sizing: border-box;
}

input:focus, textarea:focus { outline: none; border-color: var(--color-primary); }

textarea { resize: vertical; min-height: 80px; }

.field-error { color: #dc2626; font-size: .75rem; margin-top: .25rem; min-height: .9rem; }

@media (max-width: 768px) {
  .ficha { grid-template-columns: 1fr; gap: 1.5rem; }
  .form-row { grid-template-columns: 1fr; }
}
</style>
