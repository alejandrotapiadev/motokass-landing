---
import MainLayout from "../layouts/MainLayout.astro";
import FilteredMotoList from "../components/FilteredMotoList.jsx";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { getAllMotorcycles, toLegacyMoto, MOTO_SEGMENTS } from "../lib/catalog/motorcycles";

const motos = getAllMotorcycles().map(toLegacyMoto);
const segmentos = MOTO_SEGMENTS.map((s) => ({ value: s.slug, label: s.name }));

// ?segmento=enduro (enlaces de la home / menú) y ?marca=Rieju
const segParam = Astro.url.searchParams.get("segmento") ?? "";
const initialSegmento = MOTO_SEGMENTS.some((s) => s.slug === segParam) ? segParam : "";
const marcaParam = Astro.url.searchParams.get("marca") ?? "";
const initialMarca = ["Rieju", "Sherco"].find((m) => m.toLowerCase() === marcaParam.toLowerCase()) ?? "";
const segInfo = MOTO_SEGMENTS.find((s) => s.slug === initialSegmento);
const h1 = segInfo ? `Motos ${segInfo.name.toLowerCase()}` : "Catálogo de motos";
---

<MainLayout
  title="MOTOKASS - Catálogo de Motos | Rieju y Sherco en Ávila"
  description="Catálogo de motos en MOTOKASS. Distribuidor oficial de Rieju y Sherco en Ávila. Filtra por tipo, marca, categoría, cilindrada y tipo de motor."
>
  <section class="cat-top">
    <div class="container">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Motos" }]} />
      <h1 class="display">{h1}</h1>
      <p>Distribuidor oficial Rieju &amp; Sherco en Ávila. {motos.length} modelos con financiación, prueba de moto y taller propio.</p>
    </div>
  </section>
  <section class="section catalogo">
    <div class="container">
      <FilteredMotoList motos={motos} segmentos={segmentos} initialSegmento={initialSegmento} initialMarca={initialMarca} client:load />
    </div>
  </section>
</MainLayout>

<style>
.cat-top { padding: 1.5rem 0 0; }
.cat-top h1 { font-size: clamp(2.6rem, 6.5vw, 5rem); margin: 1.25rem 0 .5rem; }
.cat-top p { color: var(--text-2); margin: 0; max-width: 60ch; }
.catalogo { padding: 1.75rem 0 4rem; }
</style>
