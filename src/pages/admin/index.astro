---
// Requiere env: ADMIN_PASSWORD
if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const password = data.get("password")?.toString();

  if (password && password === import.meta.env.ADMIN_PASSWORD) {
    Astro.cookies.set("admin_session", "ok", {
      httpOnly: true,
      secure: true,
      sameSite: "lax",
      maxAge: 60 * 60 * 8,
      path: "/admin",
    });
    return Astro.redirect("/admin/citas");
  }
}

if (Astro.cookies.get("admin_session")?.value === "ok") {
  return Astro.redirect("/admin/citas");
}

const error = Astro.request.method === "POST";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · MOTOKASS</title>
  <link rel="icon" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f1f5f9; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .card { background: white; border-radius: 12px; padding: 2.5rem 2rem; width: 100%; max-width: 360px; box-shadow: 0 4px 24px rgba(0,0,0,.1); }
    .brand { display: flex; align-items: center; gap: .75rem; margin-bottom: 2rem; }
    .brand-dot { width: 12px; height: 12px; border-radius: 50%; background: #dc2626; }
    .brand h1 { font-size: 1.3rem; font-weight: 800; color: #1F3F7A; }
    label { display: block; font-size: .85rem; font-weight: 600; color: #374151; margin-bottom: .4rem; }
    input[type="password"] { width: 100%; padding: .75rem 1rem; border: 1.5px solid #e5e7eb; border-radius: 8px; font-size: 1rem; margin-bottom: 1.25rem; }
    input[type="password"]:focus { outline: none; border-color: #1F3F7A; }
    button { width: 100%; padding: .85rem; background: #1F3F7A; color: white; border: none; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; }
    button:hover { filter: brightness(1.1); }
    .error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; border-radius: 8px; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1.25rem; }
  </style>
</head>
<body>
  <div class="card">
    <div class="brand">
      <div class="brand-dot"></div>
      <h1>MOTOKASS Admin</h1>
    </div>
    {error && <div class="error">Contraseña incorrecta. Inténtalo de nuevo.</div>}
    <form method="POST">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" autofocus required />
      <button type="submit">Acceder</button>
    </form>
  </div>
</body>
</html>
