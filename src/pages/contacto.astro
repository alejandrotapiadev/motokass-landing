---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contacto | MOTOKASS Taller y Tienda de Motos"
  description="Contacta con MOTOKASS en Ávila. Resuelve tus dudas sobre nuestras motos y servicios de taller. Te respondemos en el menor tiempo posible."
>
  <section class="contact">
    <div class="contact__overlay">
      <div class="contact__container">

        <header class="contact__header">
          <h1>Contacto</h1>
          <p>Cuéntanos qué necesita tu moto y te responderemos lo antes posible.</p>
        </header>

        <div class="contact__card">

          <div id="success-msg" class="alert alert--success" hidden aria-live="polite">
            Mensaje enviado correctamente. Te responderemos en breve.
          </div>
          <div id="error-msg" class="alert alert--error" hidden aria-live="polite"></div>

          <form class="form" id="contact-form" novalidate>

            <div class="form__group">
              <input type="text" id="name" name="name" required placeholder=" " autocomplete="name" />
              <label for="name">Nombre <span class="required">*</span></label>
              <span class="field-error" id="name-error" role="alert"></span>
            </div>

            <div class="form__group">
              <input type="email" id="email" name="email" required placeholder=" " autocomplete="email" />
              <label for="email">Email <span class="required">*</span></label>
              <span class="field-error" id="email-error" role="alert"></span>
            </div>

            <div class="form__group">
              <input type="tel" id="phone" name="phone" placeholder=" " autocomplete="tel" />
              <label for="phone">Teléfono (opcional)</label>
            </div>

            <div class="form__group">
              <textarea id="message" name="message" rows="5" required placeholder=" "></textarea>
              <label for="message">Mensaje <span class="required">*</span></label>
              <span class="field-error" id="message-error" role="alert"></span>
            </div>

            <div class="form__group form__group--consent">
              <label class="consent-label">
                <input type="checkbox" id="privacidad" name="privacidad" required />
                <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener noreferrer">política de privacidad</a> de MOTOKASS. <span class="required">*</span></span>
              </label>
              <span class="field-error" id="privacidad-error" role="alert"></span>
            </div>

            <p class="privacy-notice">
              Tus datos se usarán para responder a tu consulta. Responsable: MOTOKASS · info@motokass.com.
              Puedes ejercer tus derechos de acceso, rectificación y supresión en cualquier momento.
            </p>

            <button type="submit" id="submit-btn" class="btn-primary">
              <span id="btn-text">Enviar mensaje</span>
              <span id="btn-loading" hidden>Enviando...</span>
            </button>

          </form>

          <div class="linea"></div>

          <a href="tel:+34920000000" class="btn-primary btn-llamar">Llamar</a>

        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text")!;
  const btnLoading = document.getElementById("btn-loading")!;
  const successMsg = document.getElementById("success-msg")!;
  const errorMsg = document.getElementById("error-msg")!;

  function clearErrors() {
    document.querySelectorAll<HTMLElement>(".field-error").forEach((el) => (el.textContent = ""));
    document.querySelectorAll<HTMLElement>(".input--error").forEach((el) => el.classList.remove("input--error"));
  }

  function showFieldError(id: string, msg: string) {
    const err = document.getElementById(`${id}-error`);
    const field = document.getElementById(id);
    if (err) err.textContent = msg;
    if (field) field.classList.add("input--error");
  }

  function validate(data: Record<string, string>): boolean {
    let ok = true;
    clearErrors();
    if (!data.name.trim()) { showFieldError("name", "Campo obligatorio"); ok = false; }
    if (!data.email.trim()) { showFieldError("email", "Campo obligatorio"); ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) { showFieldError("email", "Introduce un email válido"); ok = false; }
    if (!data.message.trim()) { showFieldError("message", "Campo obligatorio"); ok = false; }
    else if (data.message.trim().length < 10) { showFieldError("message", "El mensaje es demasiado corto"); ok = false; }
    if (!data.privacidad) { showFieldError("privacidad", "Debes aceptar la política de privacidad para continuar"); ok = false; }
    return ok;
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.hidden = loading;
    btnLoading.hidden = !loading;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successMsg.hidden = true;
    errorMsg.hidden = true;

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!validate(data)) return;

    setLoading(true);
    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const json = await res.json();

      if (res.ok) {
        form.reset();
        successMsg.hidden = false;
        successMsg.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        errorMsg.textContent = json.error || "Error al enviar. Inténtalo de nuevo.";
        errorMsg.hidden = false;
      }
    } catch {
      errorMsg.textContent = "Error de conexión. Comprueba tu internet e inténtalo de nuevo.";
      errorMsg.hidden = false;
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
/* ====== LAYOUT ====== */

.contact {
  min-height: 100vh;
  padding: 6rem 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: url('/src/assets/img/backgrounds/contacto2.webp') center/cover no-repeat;
}

.contact__overlay {
  width: 100%;
  backdrop-filter: brightness(0.95);
}

.contact__container {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  color: var(--color-white);
}

.contact__header h1 {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
}

.contact__header p {
  font-size: 1.15rem;
  opacity: 0.9;
  margin-bottom: 3rem;
}

/* ====== CARD ====== */

.contact__card {
  background: var(--color-gray-medium);
  border-radius: 1.2rem;
  padding: 3rem 2.5rem;
  box-shadow: 0 20px 50px rgba(0,0,0,0.15);
  text-align: left;
  color: var(--color-gray-dark);
  animation: fadeInUp .6s ease forwards;
}

/* ====== ALERTS ====== */

.alert {
  padding: 1rem 1.25rem;
  border-radius: 10px;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
  font-weight: 500;
}

.alert--success {
  background: #ecfdf5;
  color: #065f46;
  border: 1px solid #a7f3d0;
}

.alert--error {
  background: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
}

/* ====== FORM ====== */

.form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.form__group {
  position: relative;
}

.form__group input,
.form__group textarea {
  width: 100%;
  padding: 1.2rem 1rem .8rem;
  border-radius: .8rem;
  border: 1.5px solid transparent;
  background: #f5f7f8;
  font-size: 1rem;
  transition: .25s ease;
  box-sizing: border-box;
}

.form__group textarea {
  resize: none;
}

.form__group label {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: .9rem;
  color: #777;
  pointer-events: none;
  transition: .2s ease;
}

.required {
  color: var(--color-secondary);
}

/* FLOAT */

.form__group input:focus,
.form__group textarea:focus,
.form__group input:not(:placeholder-shown),
.form__group textarea:not(:placeholder-shown) {
  border-color: var(--color-primary);
  background: #fff;
  outline: none;
}

.form__group input:focus + label,
.form__group textarea:focus + label,
.form__group input:not(:placeholder-shown) + label,
.form__group textarea:not(:placeholder-shown) + label {
  top: .4rem;
  font-size: .7rem;
  color: var(--color-primary);
}

.form__group input.input--error,
.form__group textarea.input--error {
  border-color: #dc2626;
}

.field-error {
  color: #dc2626;
  font-size: 0.78rem;
  margin-top: 0.3rem;
  display: block;
  min-height: 1rem;
}

.linea {
  width: 100%;
  height: 1px;
  background: #ddd;
  margin: 1.5rem 0;
}

/* BUTTONS */

.btn-primary {
  display: block;
  width: 100%;
  padding: 1.1rem;
  border-radius: .8rem;
  border: none;
  font-weight: 700;
  cursor: pointer;
  font-size: 1rem;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: var(--color-white);
  transition: .25s ease;
  text-align: center;
  text-decoration: none;
  box-sizing: border-box;
}

.btn-primary:hover:not(:disabled) {
  transform: translateY(-4px);
}

.btn-primary:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.btn-llamar {
  background: linear-gradient(135deg, #16a34a, #15803d);
}

.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 400;
  color: #374151;
  line-height: 1.5;
}
.consent-label input[type="checkbox"] {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  margin-top: 2px;
  accent-color: var(--color-primary);
  cursor: pointer;
}
.consent-label a { color: var(--color-primary); }

.privacy-notice {
  font-size: 0.78rem;
  color: #9ca3af;
  line-height: 1.6;
  padding: 0.65rem 0.75rem;
  background: rgba(255,255,255,0.5);
  border-radius: 0.5rem;
  border-left: 3px solid #e2e8f0;
  margin-top: -0.5rem;
}

@media (min-width: 768px) {
  .contact__header h1 { font-size: 3.4rem; }
}
</style>
