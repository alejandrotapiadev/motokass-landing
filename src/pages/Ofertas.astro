---
import MainLayout from "../layouts/MainLayout.astro";
import OffersTabs from "../components/offers/OffersTabs.astro";
// Las ofertas salen de datos reales: motos con precio rebajado, equipamiento
// rebajado (Supabase) y src/data/workshop-offers.ts. Nada inventado.
---

<MainLayout
  title="Ofertas | MOTOKASS Taller y Tienda de Motos"
  description="Ofertas de MOTOKASS en Ávila: motos, equipamiento para motoristas y servicios de taller. Suscríbete para recibir las nuevas promociones."
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero__content">
      <span class="hero__badge">Ofertas activas</span>
      <h1>Aprovecha nuestras <br />promociones</h1>
      <p>Motos, equipamiento y servicios de taller con precio especial. Suscríbete y te avisamos de cada nueva promoción.</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <OffersTabs id="ofertas" limit={24} />
    </div>
  </section>

  <!-- CTA NEWSLETTER -->
  <section class="section section--cta">
    <div class="container">
      <div class="cta-box">
        <div class="cta-box__text">
          <h2>¿No te quieres perder ninguna oferta?</h2>
          <p>Suscríbete y te avisamos en cuanto publiquemos nuevas promociones.</p>
        </div>
        <form id="subscribe-form" class="cta-box__form">
          <input type="email" id="sub-email" name="email" placeholder="Tu email" required />
          <button type="submit" id="sub-btn">
            <span id="sub-text">Suscribirme</span>
            <span id="sub-loading" hidden>Enviando...</span>
          </button>
        </form>
        <label class="sub-consent">
          <input type="checkbox" id="sub-privacidad" required />
          <span>Acepto recibir novedades y ofertas de MOTOKASS y he leído la <a href="/privacidad" target="_blank" rel="noopener noreferrer">política de privacidad</a>.</span>
        </label>
        <p id="sub-success" class="cta-feedback cta-feedback--ok" hidden>📧 Revisa tu email y confirma la suscripción para completar el proceso.</p>
        <p id="sub-error" class="cta-feedback cta-feedback--err" hidden></p>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  const form = document.getElementById("subscribe-form") as HTMLFormElement;
  const subBtn = document.getElementById("sub-btn") as HTMLButtonElement;
  const subText = document.getElementById("sub-text")!;
  const subLoading = document.getElementById("sub-loading")!;
  const subSuccess = document.getElementById("sub-success")!;
  const subError = document.getElementById("sub-error")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    subError.hidden = true;

    const consentCheck = document.getElementById("sub-privacidad") as HTMLInputElement;
    if (!consentCheck.checked) {
      subError.textContent = "Debes aceptar la política de privacidad para suscribirte.";
      subError.hidden = false;
      return;
    }

    subBtn.disabled = true;
    subText.hidden = true;
    subLoading.hidden = false;

    const email = (document.getElementById("sub-email") as HTMLInputElement).value;
    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const json = await res.json();
      if (res.ok) {
        form.hidden = true;
        subSuccess.hidden = false;
      } else {
        subError.textContent = json.error || "Error al suscribirse. Inténtalo de nuevo.";
        subError.hidden = false;
      }
    } catch {
      subError.textContent = "Error de conexión. Inténtalo de nuevo.";
      subError.hidden = false;
    } finally {
      subBtn.disabled = false;
      subText.hidden = false;
      subLoading.hidden = true;
    }
  });
</script>

<style>
/* HERO */
.hero {
  background: var(--ink);
  padding: 5rem 1.5rem 4rem;
  text-align: center;
  color: white;
}

.hero__badge {
  display: inline-block;
  background: var(--color-secondary);
  color: white;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 0.35rem 1rem;
  border-radius: 999px;
  margin-bottom: 1.25rem;
}

.hero h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 1rem;
}

.hero p {
  font-size: 1.05rem;
  opacity: 0.85;
  max-width: 520px;
  margin: 0 auto;
}

/* SECTIONS */
.section {
  padding: 4rem 1.5rem;
}

.section--light {
  background: #f8fafc;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
}

.section__header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section__header h2 {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 0.5rem;
}

.section__header p {
  color: #64748b;
  font-size: 1rem;
}

/* CTA NEWSLETTER */
.section--cta {
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  color: white;
}

.cta-box {
  max-width: 620px;
  margin: 0 auto;
  text-align: center;
}

.cta-box__text h2 {
  font-size: clamp(1.4rem, 3vw, 1.9rem);
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.cta-box__text p {
  opacity: 0.85;
  margin-bottom: 1.75rem;
}

.cta-box__form {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  justify-content: center;
}

.cta-box__form input {
  flex: 1;
  min-width: 200px;
  padding: 0.85rem 1.1rem;
  border-radius: 8px;
  border: none;
  font-size: 0.95rem;
  outline: none;
}

.cta-box__form button {
  background: var(--color-secondary);
  color: white;
  border: none;
  padding: 0.85rem 1.75rem;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: filter 0.2s;
  white-space: nowrap;
}

.cta-box__form button:hover:not(:disabled) {
  filter: brightness(1.1);
}

.cta-box__form button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.cta-feedback {
  margin-top: 1rem;
  font-size: 0.9rem;
  font-weight: 500;
}

.cta-feedback--ok { color: #a7f3d0; }
.cta-feedback--err { color: #fca5a5; }

.sub-consent {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-top: 0.75rem;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.65);
  cursor: pointer;
  line-height: 1.5;
}
.sub-consent input[type="checkbox"] {
  flex-shrink: 0;
  margin-top: 2px;
  accent-color: #16a34a;
  width: 14px;
  height: 14px;
  cursor: pointer;
}
.sub-consent a { color: rgba(255,255,255,0.85); text-decoration: underline; }
</style>
